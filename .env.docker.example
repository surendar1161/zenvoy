# Copy to .env.docker and fill in values, then: docker compose up --build
#
# Supabase stays external (hosted or self-hosted separately).
# Cron jobs: call these URLs from your scheduler with Authorization: Bearer $CRON_SECRET
#   GET /api/cron/recurring-invoices  (daily 06:00 UTC)
#   GET /api/cron/proposal-follow-ups (daily 07:00 UTC)

# ── Public (embedded in browser bundle at BUILD time) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHARGEBEE_SITE=your-chargebee-site

# ── Server-only (runtime) ───────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHARGEBEE_SITE=
CHARGEBEE_API_KEY=
CHARGEBEE_PRO_MONTHLY_PLAN_ID=
CHARGEBEE_PRO_YEARLY_PLAN_ID=
CHARGEBEE_BUSINESS_MONTHLY_PLAN_ID=
CHARGEBEE_BUSINESS_YEARLY_PLAN_ID=
CHARGEBEE_WEBHOOK_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@dealpilot.app
CRON_SECRET=change-me-in-production
