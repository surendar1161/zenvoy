# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# ── Chargebee ─────────────────────────────────────────────────────
CHARGEBEE_SITE=your-site-name
CHARGEBEE_API_KEY=your-full-access-key
# Product Catalog 2.0 (default): use Item Price IDs below.
# Legacy Plans only: set CHARGEBEE_CATALOG=plans
CHARGEBEE_CATALOG=items
# IDs below must be Plan Price Point IDs (Chargebee → Plans → [plan] → Pricing),
# NOT plan item IDs. Importing plans via CSV creates items only — add price points separately.
CHARGEBEE_PRO_MONTHLY_PLAN_ID=pro-monthly
CHARGEBEE_PRO_YEARLY_PLAN_ID=pro-yearly
CHARGEBEE_BUSINESS_MONTHLY_PLAN_ID=business-monthly
CHARGEBEE_BUSINESS_YEARLY_PLAN_ID=business-yearly
CHARGEBEE_WEBHOOK_PASSWORD=your-webhook-password
NEXT_PUBLIC_CHARGEBEE_SITE=your-site-name

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
GOOGLE_SITE_VERIFICATION=your-verification-token
